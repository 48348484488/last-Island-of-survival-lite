<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.oxide.bridgeprobe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application android:label="Oxide Bridge Test" android:hasCode="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".OverlayProbeService" android:exported="false" />
        <!-- Diagnostic-only: external synthetic feed requires DUMP permission (ADB shell). -->
        <receiver android:name=".SyntheticFeedReceiver" android:exported="true"
                  android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.oxide.bridgeprobe.SYNTHETIC_FEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
